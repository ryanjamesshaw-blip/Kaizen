# Postgres connection used by the application (INSERT-only on audit_events — see db/migrate)
DATABASE_URL=postgresql://kaizen:kaizen@localhost:5432/kaizen
# Superuser/owner connection used ONLY for migrations
DATABASE_ADMIN_URL=postgresql://kaizen:kaizen@localhost:5432/kaizen
# 32+ random bytes, base64. Used to sign session cookies.
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32
# Public URL of the app
APP_URL=http://localhost:3000
ENGINE_SECRET=change-me
